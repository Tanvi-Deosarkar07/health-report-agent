{
  "_meta": {
    "description": "Reference-range table for health report classification. Single source of truth for tiering. The classifier reads cutoffs from here; no thresholds are hardcoded in logic. By design, these ranges live in this editable config file (not in code) so a qualified clinical SME can review and update them independently, without code changes.",
    "STATUS": "ILLUSTRATIVE PLACEHOLDER DATA — for portfolio/demo use only. The cutoffs below are plausible but UNVERIFIED and must not be used to interpret real health reports. In a production deployment, a qualified clinician (SME) owns this table and sources cutoffs from an authoritative reference (e.g. the ordering lab's own reference ranges, ACC/AHA, ADA, KDIGO, Endocrine Society guidelines). Ranges vary by lab, assay, age, and guideline body.",
    "version": "0.1-demo-placeholder",
    "tier_semantics": {
      "NORMAL": "Within healthy reference range.",
      "BORDERLINE": "Outside normal but not immediately dangerous; lifestyle focus + monitor.",
      "CRITICAL": "Outside safe range; prompt physician attention warranted."
    },
    "direction_semantics": {
      "two_sided": "Both low and high values are abnormal (e.g. potassium, sodium).",
      "high_bad": "Only high values are abnormal (e.g. LDL, glucose, triglycerides).",
      "low_bad": "Only low values are abnormal (e.g. HDL, vitamin D, hemoglobin)."
    },
    "matching_note": "sex: 'M', 'F', or 'ANY'. age_min/age_max are inclusive years; use 0 and 200 for open ends. The classifier picks the row whose sex and age bracket match the patient; 'ANY' is the fallback."
  },

